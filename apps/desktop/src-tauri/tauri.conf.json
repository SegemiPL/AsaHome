{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas/main/schemas/tauri.config.json",
  "productName": "AsaHome Desktop Pet",
  "version": "0.1.0",
  "identifier": "com.asahome.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AsaHome Pet",
        "width": 300,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
