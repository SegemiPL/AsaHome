{
  "name": "asahome",
  "version": "0.1.0",
  "private": true,
  "description": "AsaHome – ASa Project website providing TTS and WindowPet service",
  "scripts": {
    "lint": "pnpm --filter !@asahome/desktop -r lint",
    "typecheck": "pnpm --filter !@asahome/desktop -r typecheck",
    "test": "pnpm --filter !@asahome/desktop -r test",
    "build": "pnpm --filter !@asahome/desktop -r build",
    "dev": "pnpm --filter @asahome/web dev",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
